<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Our.Umbraco.ContentDashboard</PackageId>
    <AssemblyName>Our.Umbraco.ContentDashboard</AssemblyName>
    <RootNamespace>Our.Umbraco.ContentDashboard</RootNamespace>
    <Product>Content Dashboard for Umbraco</Product>
    <Title>Content Dashboard for Umbraco</Title>
    <Description>Three Content-section dashboards for Umbraco 17 that show a team of editors who owns which pages. My Content lists everything you own with its publish status and how long since it was touched, Scheduled lists your pending publish and unpublish dates, and an administrators-only Ownership tab hands over everything a departing editor owned in one click. Ownership is Umbraco's built-in creator field, so transfers show up in the standard UI - and they deliberately avoid stamping UpdateDate, so a transfer never makes a page look freshly edited.</Description>
    <PackageTags>umbraco umbraco-marketplace umbraco-package umbraco-17 backoffice dashboard content editors ownership scheduling</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>



  <!-- Per-project - with versions -->
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Api.Common" Version="[17.7.0,18.0.0)" />
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="[17.7.0,18.0.0)" />
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="[17.7.0,18.0.0)" />
    <PackageReference Include="Umbraco.Cms.Web.Website" Version="[17.7.0,18.0.0)" />

    <!--
      Umbraco 17 still generates OpenAPI with Swashbuckle. The composer uses its SwaggerGenOptions
      and Microsoft.OpenApi's OpenApiInfo, and both come in through Umbraco.Cms.Api.Management at
      the version Umbraco itself was built against. The 17 extension template references
      Swashbuckle.AspNetCore directly, but this package depends on nothing outside Microsoft and
      Umbraco, so the transitive reference is used instead.
    -->
  </ItemGroup>

  <ItemGroup>
    <!-- Don't include the client folder as part of packaging nuget build -->
    <Content Remove="Client\**" />

    <!-- However make the Umbraco-package.json included for dotnet pack or nuget package and visible to the solution -->
    <None Include="Client\public\umbraco-package.json" Pack="false" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\img\icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!--
    wwwroot/ is Vite output and is not committed, so a fresh clone would otherwise build a backend
    with no dashboard. Build the client once if the bundle is missing; day-to-day you use
    `npm run watch` in Client/, and this target then stays out of the way.
    Set -p:BuildClient=false to skip it entirely (e.g. on a build agent that builds the client itself).
  -->
  <Target Name="BuildContentDashboardClient" BeforeTargets="BeforeBuild" Condition="'$(BuildClient)' != 'false' AND !Exists('$(MSBuildProjectDirectory)\wwwroot\App_Plugins\ContentDashboard\content-dashboard.js')">
    <Message Text="Content Dashboard client bundle not found - building it with npm." Importance="high" />
    <Exec Command="npm ci" WorkingDirectory="$(MSBuildProjectDirectory)\Client" Condition="!Exists('$(MSBuildProjectDirectory)\Client\node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)\Client" />
  </Target>

</Project>
